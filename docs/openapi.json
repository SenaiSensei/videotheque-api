    "/users/{user_id}/favorites": {
      "parameters": [
        {
          "name": "user_id",
          "in": "path",
          "required": true,
          "description": "Identifiant du compte",
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "example": "665f1c2ab3d4e5f6a7b8c9d0"
