          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Droits insuffisants (forbidden)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Compte introuvable (user_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Favoris"
        ],
        "summary": "Ajout d'un favori",
        "operationId": "addFavorite",
        "description": "Propriétaire du compte uniquement. Un film déjà en favori n'est pas ajouté deux fois.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FavoriteRequest"
              },
              "example": {
                "film_id": "665f1c2ab3d4e5f6a7b8c9d0"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Favori ajouté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteList"
                }
              }
            }
          },
          "200": {
            "description": "Film déjà en favori",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteList"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides ou incomplètes (invalid_data)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Droits insuffisants (forbidden)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Compte ou film introuvable (user_not_found, film_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/users/{user_id}/favorites/{film_id}": {
      "parameters": [
        {
          "name": "user_id",
          "in": "path",
          "required": true,
          "description": "Identifiant du compte",
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "example": "665f1c2ab3d4e5f6a7b8c9d0"
          }
        },
        {
          "name": "film_id",
          "in": "path",
          "required": true,
          "description": "Identifiant du film",
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "example": "665f1c2ab3d4e5f6a7b8c9d0"
          }
        }
      ],
      "delete": {
        "tags": [
          "Favoris"
        ],
        "summary": "Retrait d'un favori",
        "operationId": "removeFavorite",
        "description": "Propriétaire du compte uniquement. Sans effet si le film n'est pas en favori.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Favoris à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteList"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Droits insuffisants (forbidden)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Compte introuvable ou id de film mal formé (user_not_found, film_not_found)",
            "content": {
