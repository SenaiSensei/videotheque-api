    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Jeton obtenu avec POST /login ou POST /users"
      }
    },
    "schemas": {
      "Person": {
        "type": "object",
        "required": [
          "last_name"
        ],
        "properties": {
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "example": "Tarantino"
          },
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "example": "Quentin",
            "description": "Facultatif, vide par défaut"
          }
        }
      },
      "Support": {
        "type": "object",
        "required": [
          "type",
          "location"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "dvd",
              "bluray",
              "digital"
            ]
          },
          "location": {
            "type": "string",
            "maxLength": 500,
            "description": "Étagère ou chemin du fichier",
            "example": "Étagère A3"
          }
        }
      },
      "FilmInput": {
        "type": "object",
        "required": [
          "title",
          "director",
          "year"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "director": {
            "$ref": "#/components/schemas/Person"
          },
          "actors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Doublons retirés"
          },
          "year": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 2100
          },
          "supports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Support"
            }
          },
          "poster_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "description": "Facultatif. Adresse http:// ou https:// de l'affiche, vide par défaut",
            "example": "https://exemple.org/affiches/pulp_fiction.jpg"
          }
        }
      },
      "Film": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "_id"
            ],
            "properties": {
              "_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{24}$",
                "example": "665f1c2ab3d4e5f6a7b8c9d0"
              }
            }
          },
          {
            "$ref": "#/components/schemas/FilmInput"
          }
        ],
        "example": {
          "_id": "665f1c2ab3d4e5f6a7b8c9d0",
          "title": "Pulp Fiction",
          "description": "Plusieurs histoires criminelles se croisent à Los Angeles.",
          "director": {
            "last_name": "Tarantino",
            "first_name": "Quentin"
          },
          "actors": [
            {
              "last_name": "Travolta",
              "first_name": "John"
            },
            {
              "last_name": "Thurman",
              "first_name": "Uma"
            }
          ],
          "genres": [
            "Policier",
            "Drame"
          ],
          "year": 1994,
          "supports": [
            {
              "type": "bluray",
              "location": "Étagère A3"
            },
            {
              "type": "digital",
              "location": "/films/pulp_fiction.mkv"
            }
          ],
          "poster_url": "https://exemple.org/affiches/pulp_fiction.jpg"
        }
      },
      "FilmList": {
        "type": "object",
        "properties": {
          "films": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Film"
            }
          }
        }
      },
      "UserPublic": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "example": "665f1c2ab3d4e5f6a7b8c9d0"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@example.org"
          },
          "username": {
            "type": "string",
            "example": "admin"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "admin"
              ]
            },
            "example": [
              "user",
              "admin"
            ]
          },
          "favorites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$",
              "example": "665f1c2ab3d4e5f6a7b8c9d0"
            }
          }
        }
      },
      "UserList": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserPublic"
            }
          }
        }
      },
      "Authentication": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton JWT, valable une heure"
          },
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "username",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128
          }
        }
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "current_password": {
            "type": "string",
            "format": "password",
            "description": "Obligatoire pour changer de mot de passe"
          },
          "new_password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128
          }
        }
      },
      "RolesRequest": {
        "type": "object",
        "required": [
          "roles"
        ],
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "admin"
              ]
            }
          }
        }
      },
      "FavoriteRequest": {
        "type": "object",
        "required": [
          "film_id"
        ],
        "properties": {
          "film_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "example": "665f1c2ab3d4e5f6a7b8c9d0"
          }
        }
      },
      "FavoriteList": {
        "type": "object",
        "properties": {
          "favorites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$",
              "example": "665f1c2ab3d4e5f6a7b8c9d0"
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Film supprimé"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 409
          },
          "code": {
            "type": "string",
            "example": "email_taken"
          },
          "message": {
            "type": "string",
            "example": "Email déjà utilisé"
          }
        }
      }
    }
  }
}