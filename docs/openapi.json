{
  "openapi": "3.0.3",
  "info": {
    "title": "API Vidéothèque",
    "version": "1.0.0",
    "description": "API REST du tiers d'accès aux données (TP RT0705).\n\n**Utilisation** : appelez `POST /login`, copiez le `token` de la réponse, puis cliquez sur **Authorize** et collez-le (sans le préfixe Bearer). Toutes les routes, sauf `POST /login` et `POST /users`, demandent ce jeton.\n\nLes identifiants sont des ObjectId MongoDB au format texte (24 caractères hexadécimaux). Toutes les erreurs sont renvoyées au format `Error`."
  },
  "servers": [
    {
      "url": "/",
      "description": "Cette API"
    }
  ],
  "tags": [
    {
      "name": "Films",
      "description": "Catalogue commun et recherche"
    },
    {
      "name": "Comptes",
      "description": "Connexion, inscription, profil et rôles"
    },
    {
      "name": "Favoris",
      "description": "Films favoris d'un compte"
    }
  ],
  "paths": {
    "/films": {
      "get": {
        "tags": [
          "Films"
        ],
        "summary": "Liste du catalogue et recherche",
        "operationId": "listFilms",
        "description": "Sans filtre, renvoie tout le catalogue trié par titre. Les filtres renseignés se cumulent.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "Recherche partielle, insensible à la casse",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "director",
            "in": "query",
            "description": "Nom ou prénom du réalisateur, recherche partielle",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "in": "query",
            "description": "Nom ou prénom d'un acteur, recherche partielle",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "genre",
            "in": "query",
            "description": "Genre exact, insensible à la casse",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "description": "Année exacte",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "support",
            "in": "query",
            "description": "Type de support",
            "schema": {
              "type": "string",
              "enum": [
                "dvd",
                "bluray",
                "digital"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Films trouvés (liste éventuellement vide)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilmList"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides ou incomplètes (invalid_data)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Films"
        ],
        "summary": "Ajout d'un film",
        "operationId": "createFilm",
        "description": "Réservé aux administrateurs. L'_id est généré par MongoDB.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FilmInput"
              },
              "example": {
                "title": "Pulp Fiction",
                "description": "Plusieurs histoires criminelles se croisent à Los Angeles.",
                "director": {
                  "last_name": "Tarantino",
                  "first_name": "Quentin"
                },
                "actors": [
                  {
                    "last_name": "Travolta",
                    "first_name": "John"
                  },
                  {
                    "last_name": "Thurman",
                    "first_name": "Uma"
                  }
                ],
                "genres": [
                  "Policier",
                  "Drame"
                ],
                "year": 1994,
                "supports": [
                  {
                    "type": "bluray",
                    "location": "Étagère A3"
                  },
                  {
                    "type": "digital",
                    "location": "/films/pulp_fiction.mkv"
                  }
                ],
                "poster_url": "https://exemple.org/affiches/pulp_fiction.jpg"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Film créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Film"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides ou incomplètes (invalid_data)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Droits insuffisants (forbidden)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/films/{film_id}": {
      "parameters": [
        {
          "name": "film_id",
          "in": "path",
          "required": true,
          "description": "Identifiant du film",
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "example": "665f1c2ab3d4e5f6a7b8c9d0"
          }
        }
      ],
      "get": {
        "tags": [
          "Films"
        ],
        "summary": "Fiche d'un film",
        "operationId": "getFilm",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Film",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Film"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Film introuvable (film_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Films"
        ],
        "summary": "Modification d'un film",
        "operationId": "updateFilm",
        "description": "Réservé aux administrateurs. Remplace toutes les données du film, sans changer son _id.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FilmInput"
              },
              "example": {
                "title": "Pulp Fiction",
                "description": "Plusieurs histoires criminelles se croisent à Los Angeles.",
                "director": {
                  "last_name": "Tarantino",
                  "first_name": "Quentin"
                },
                "actors": [
                  {
                    "last_name": "Travolta",
                    "first_name": "John"
                  },
                  {
                    "last_name": "Thurman",
                    "first_name": "Uma"
                  }
                ],
                "genres": [
                  "Policier",
                  "Drame"
                ],
                "year": 1994,
                "supports": [
                  {
                    "type": "bluray",
                    "location": "Étagère A3"
                  },
                  {
                    "type": "digital",
                    "location": "/films/pulp_fiction.mkv"
                  }
                ],
                "poster_url": "https://exemple.org/affiches/pulp_fiction.jpg"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Film modifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Film"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides ou incomplètes (invalid_data)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Droits insuffisants (forbidden)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Film introuvable (film_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Films"
        ],
        "summary": "Suppression d'un film",
        "operationId": "deleteFilm",
        "description": "Réservé aux administrateurs. Retire aussi le film des favoris de tous les utilisateurs.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Film supprimé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré, ou compte supprimé (invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Droits insuffisants (forbidden)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Film introuvable (film_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Comptes"
        ],
        "summary": "Connexion",
        "operationId": "login",
        "description": "Route publique. Renvoie un jeton JWT valable une heure.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "admin@example.org",
                "password": "mot de passe"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authentication"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides ou incomplètes (invalid_data)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants incorrects (invalid_credentials)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Comptes"
