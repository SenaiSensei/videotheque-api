            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Comptes"
        ],
        "summary": "Suppression d'un compte",
        "operationId": "deleteUser",
        "description": "Son propre compte, ou n'importe quel compte pour un administrateur. Le dernier administrateur ne peut pas être supprimé.",
        "security": [
          {
            "bearerAuth": []
