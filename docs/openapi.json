        "summary": "Liste des comptes",
        "operationId": "listUsers",
        "description": "Réservé aux administrateurs. Comptes triés par nom d'utilisateur.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Comptes",
            "content": {
